# HTTP 监听地址
HTTP_ADDR=:8420

# PostgreSQL + PostGIS 连接串
DATABASE_URL=postgres://map:map@localhost:5432/mapserver?sslmode=disable

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单次要素查询上限
MAX_FEATURES=100000

# 矢量瓦片最大缩放级别
TILE_MAX_ZOOM=22
# 单个矢量瓦片最多要素数（低缩放级别会自动收紧到 1500）
TILE_MAX_FEATURES=5000
# 是否按瓦片分辨率简化几何
TILE_SIMPLIFY=true

# ── 自然语言地图助手（BYOK）────────────────────────────
# 默认使用 DeepSeek；API Key 由前端每次请求携带，不落库
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
# 允许访问私有网段（本地 Ollama / 内网网关）时设为 true
AI_ALLOW_PRIVATE=false

# ── 鉴权 ──────────────────────────────────────────────
# 运行环境：production 时禁止使用默认 JWT 密钥
APP_ENV=development
# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=dev-secret-change-me
# Token 有效期（小时）
TOKEN_TTL_HOURS=72
# 首次启动自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 限流（按客户端 IP，0 为禁用）──────────────────────
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60

# ── 缓存 ──────────────────────────────────────────────
# 瓦片缓存条目数（0 表示禁用）
TILE_CACHE_ENTRIES=2048
# 瓦片缓存过期时间（秒）
TILE_CACHE_TTL_SECONDS=300
# 元数据（图层/样式/能力）缓存过期时间（秒）
META_CACHE_TTL_SECONDS=30

# 瓦片磁盘缓存目录（留空禁用）与过期时间（秒）
TILE_CACHE_DIR=./data/tile-cache
TILE_DISK_TTL_SECONDS=3600
# 磁盘缓存容量上限（MB，0 为不限，超过时按 LRU 淘汰）
TILE_CACHE_MAX_MB=256

# ── HTTPS（可选，留空由反向代理终止 TLS）──────────────
TLS_CERT_FILE=
TLS_KEY_FILE=

# 前端静态资源目录（留空时优先使用内嵌资源，否则自动探测 frontend/dist）
STATIC_DIR=
